{
  "name": "sistem-nilai-zero-trust",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "seed": "node db/seed.js",
    "start:gateway": "node gateway/app.js",
    "start:nilai": "node service-nilai/app.js",
    "start:transkrip": "node service-transkrip/app.js",
