	"item": [
		{
			"name": "1. Autentikasi & Verifikasi Perangkat",
			"item": [
				{
					"name": "1.1 Login Dosen 1 (Berhasil)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var data = pm.response.json();",
									"    pm.collectionVariables.set('token_dosen1', data.accessToken);",
									"    pm.collectionVariables.set('refresh_token_dosen1', data.refreshToken);",
									"    console.log('Token Dosen 1 tersimpan');",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "X-Device-ID",
								"value": "DSN1-LAPTOP"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"dosen1\",\n  \"password\": \"dosen123\"\n}"
						},
						"url": {
							"raw": "{{gateway_url}}/auth/login",
							"host": [
								"{{gateway_url}}"
							],
							"path": [
								"auth",
								"login"
							]
						},
						"description": "Login berhasil untuk Dosen 1 dengan device resmi DSN1-LAPTOP. Token otomatis disimpan ke variabel {{token_dosen1}}."
					},
					"response": []
				},
